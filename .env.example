# SecureFlow configuration template. Real values go in .dev.vars (git-ignored) for `npm run dev` / `npm run deploy`,
# and become encrypted Cloudflare Worker secrets on deploy. Never commit real values or put them in browser code.

# Google Gemini (AI deep check) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional model fallback order
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest

# Cashfree Payments (paid repair). Use TEST credentials from the Cashfree Merchant Dashboard (Test mode → Developers → API Keys).
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox (default) or production. Production is refused unless ALLOW_LIVE_PAYMENTS is exactly I_HAVE_OWNER_APPROVAL.
CASHFREE_ENV=sandbox
ALLOW_LIVE_PAYMENTS=

# Authentication and email verification. Firebase API values are public web configuration;
# TOKEN_ENC_KEY is a server-only random key (at least 32 characters), used to sign OTP sessions
# and encrypt GitHub credentials. Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_AUTH_DOMAIN=
TOKEN_ENC_KEY=
RESEND_API_KEY=
ALERT_FROM=

# GitHub OAuth (only needed for repository integration)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
